{
  "name": "boundless-boston-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "e2e": "playwright test",
    "api": "uvicorn app.main:app --app-dir backend --reload --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "@cruxgarden/plasma-ui": "^0.8.0",
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
