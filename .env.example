# Set to demo for deterministic fixtures; set to live to call Tier 1 APIs.
APP_MODE=demo
CORS_ORIGINS=http://localhost:5173
CACHE_DB=.cache/public-cache.sqlite3
GOOGLE_MAPS_API_KEY=
# MBTA is public without a key; set one here to raise the project quota.
MBTA_API_KEY=
# Tier 2: free-text parsing (free key at aistudio.google.com/apikey). Model defaults to gemini-3.5-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=
# Tier 2: street-routed walk times (free key at openrouteservice.org); without it walks use a straight-line estimate.
ORS_API_KEY=
BOSTON_CKAN_URL=https://data.boston.gov/api/3/action
BOSTON_311_PACKAGE=311-service-requests
BOSTON_LICENSE_PACKAGE=active-food-establishment-licenses
